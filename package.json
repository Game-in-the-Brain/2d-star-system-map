{
  "name": "2d-star-system-map",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/inline-build.js",
    "preview": "vite preview",
    "standalone": "node scripts/inline-build.js",
    "build:wrapper": "tsc -b && vite build --base ./",
